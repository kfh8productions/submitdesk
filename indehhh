<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0e0e10">
<title>SUBMIT / DESK</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0e0e10;
  --panel:#161619;
  --panel2:#1d1d21;
  --line:#2a2a30;
  --ink:#f4f4f5;
  --mut:#7a7a85;
  --pink:#ff4d8d;
  --go:#3ddc84;
  --amber:#ffb84d;
  --no:#5a5a63;
  --font-d:'Bebas Neue',sans-serif;
  --font-m:'DM Mono',monospace;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg);color:var(--ink);font-family:var(--font-m);font-weight:300;overscroll-behavior-y:none}
body{padding:0 0 90px;min-height:100vh}
button{font-family:var(--font-m);cursor:pointer;border:none;background:none;color:inherit}
input,select,textarea{font-family:var(--font-m);font-weight:300}
::selection{background:var(--pink);color:#000}

/* header */
header{position:sticky;top:0;z-index:40;background:var(--bg);border-bottom:1px solid var(--line);padding:env(safe-area-inset-top) 18px 0}
.hd{display:flex;align-items:baseline;justify-content:space-between;padding:16px 0 12px}
.logo{font-family:var(--font-d);font-size:34px;letter-spacing:1px;line-height:.9}
.logo b{color:var(--pink);font-weight:400}
.hd .sub{font-size:10px;color:var(--mut);letter-spacing:2px;text-transform:uppercase}
.tabs{display:flex;gap:0;border-top:1px solid var(--line)}
.tab{flex:1;padding:13px 4px;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--mut);text-align:center;border-bottom:2px solid transparent}
.tab.on{color:var(--ink);border-bottom-color:var(--pink)}

.wrap{max-width:760px;margin:0 auto;padding:18px}

/* buttons */
.btn{background:var(--pink);color:#000;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;padding:12px 18px;border-radius:2px;font-weight:400}
.btn.ghost{background:none;border:1px solid var(--line);color:var(--ink)}
.btn.sm{padding:8px 12px;font-size:10px}
.btn:active{transform:translateY(1px)}

/* story cards */
.story{background:var(--panel);border:1px solid var(--line);border-radius:4px;margin-bottom:14px;overflow:hidden}
.story-hd{padding:16px 16px 14px;cursor:pointer;display:flex;justify-content:space-between;align-items:flex-start;gap:12px}
.story-hd h3{font-family:var(--font-d);font-size:24px;letter-spacing:.5px;line-height:1;font-weight:400}
.wc{font-size:11px;color:var(--pink);letter-spacing:1px;white-space:nowrap;margin-top:4px}
.story-meta{font-size:10px;color:var(--mut);letter-spacing:1px;text-transform:uppercase;margin-top:8px;display:flex;gap:14px;flex-wrap:wrap}
.story-meta b{color:var(--go);font-weight:400}
.story-meta b.amb{color:var(--amber)}
.chev{color:var(--mut);font-size:12px;transition:transform .2s}
.story.open .chev{transform:rotate(90deg)}

.story-body{display:none;border-top:1px solid var(--line)}
.story.open .story-body{display:block}

.seg{display:flex;border-bottom:1px solid var(--line)}
.seg button{flex:1;padding:11px;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--mut)}
.seg button.on{color:var(--ink);background:var(--panel2)}

.pane{padding:14px 16px}
.pane.hide{display:none}

/* match rows */
.filt{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.filt input{flex:1;min-width:120px;background:var(--panel2);border:1px solid var(--line);color:var(--ink);padding:9px 11px;border-radius:2px;font-size:12px}
.filt select{background:var(--panel2);border:1px solid var(--line);color:var(--ink);padding:9px;border-radius:2px;font-size:11px}

.mag{border:1px solid var(--line);border-radius:3px;margin-bottom:9px;background:var(--panel2)}
.mag-hd{padding:12px 13px;display:flex;align-items:center;gap:11px}
.dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.dot.go{background:var(--go)}.dot.amb{background:var(--amber)}.dot.no{background:var(--no)}
.mag-name{font-family:var(--font-d);font-size:19px;letter-spacing:.5px;flex:1;line-height:1;font-weight:400}
.mag-name .flag{font-size:9px;font-family:var(--font-m);color:var(--mut);letter-spacing:1px;margin-left:7px;vertical-align:middle}
.cap{font-size:10px;color:var(--mut);letter-spacing:.5px;white-space:nowrap}
.cap.fit{color:var(--go)}.cap.tight{color:var(--amber)}.cap.over{color:var(--no)}
.mag-x{padding:0 13px 12px;font-size:11px;color:var(--mut);line-height:1.5}
.mag-x .ed{color:var(--ink)}
.mag-x .ch{color:var(--pink)}
.mag-foot{display:flex;gap:8px;padding:0 13px 12px;flex-wrap:wrap}
.tagpill{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--mut);border:1px solid var(--line);padding:3px 7px;border-radius:2px}
.logbtn{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--pink);border:1px solid var(--pink);padding:4px 9px;border-radius:2px;margin-left:auto}

.empty{text-align:center;padding:40px 20px;color:var(--mut);font-size:12px;line-height:1.7}
.empty b{color:var(--pink);font-weight:400;font-family:var(--font-d);font-size:20px;display:block;margin-bottom:8px;letter-spacing:1px}

/* submissions log */
.sub-row{display:flex;align-items:center;gap:11px;padding:11px 0;border-bottom:1px solid var(--line)}
.sub-row:last-child{border:none}
.sub-info{flex:1;min-width:0}
.sub-mag{font-family:var(--font-d);font-size:17px;letter-spacing:.5px;line-height:1;font-weight:400}
.sub-date{font-size:10px;color:var(--mut);letter-spacing:1px;margin-top:3px}
.stat{font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:4px 8px;border-radius:2px;border:1px solid;cursor:pointer}
.stat.pending{color:var(--amber);border-color:var(--amber)}
.stat.accepted{color:var(--go);border-color:var(--go)}
.stat.rejected{color:var(--no);border-color:var(--no)}
.stat.withdrawn{color:var(--mut);border-color:var(--line)}
.del{color:var(--no);font-size:15px;padding:4px 8px}

/* modal */
.ov{position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:100;display:none;align-items:flex-end;justify-content:center}
.ov.on{display:flex}
.sheet{background:var(--panel);border:1px solid var(--line);border-bottom:none;border-radius:12px 12px 0 0;width:100%;max-width:760px;padding:22px 18px calc(28px + env(safe-area-inset-bottom));max-height:88vh;overflow-y:auto}
.sheet h2{font-family:var(--font-d);font-size:26px;letter-spacing:1px;margin-bottom:18px;font-weight:400}
.fld{margin-bottom:15px}
.fld label{display:block;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--mut);margin-bottom:6px}
.fld input,.fld select,.fld textarea{width:100%;background:var(--panel2);border:1px solid var(--line);color:var(--ink);padding:12px;border-radius:3px;font-size:14px}
.fld textarea{resize:vertical;min-height:60px}
.sheet-btns{display:flex;gap:10px;margin-top:8px}
.sheet-btns .btn{flex:1;text-align:center}

/* fab */
.fab{position:fixed;right:18px;bottom:calc(20px + env(safe-area-inset-bottom));z-index:50;background:var(--pink);color:#000;width:56px;height:56px;border-radius:50%;font-size:30px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 20px rgba(255,77,141,.35);line-height:0}
.fab:active{transform:scale(.94)}

/* factoid strip */
.strip{border-top:1px solid var(--line);margin-top:22px;padding:14px 0 4px;font-size:10px;color:var(--mut);letter-spacing:.5px;line-height:1.6}
.strip .k{color:var(--pink)}

.loading{text-align:center;padding:50px;color:var(--mut);font-size:12px;letter-spacing:2px;text-transform:uppercase}

/* window + flag badges */
.badges{display:flex;gap:6px;flex-wrap:wrap;padding:0 13px 2px}
.win{font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:3px 8px;border-radius:2px;border:1px solid}
.win.open{color:var(--go);border-color:var(--go)}
.win.rolling{color:var(--go);border-color:var(--line)}
.win.soon{color:var(--amber);border-color:var(--amber)}
.win.closed{color:var(--no);border-color:var(--line)}
.win.unknown{color:var(--mut);border-color:var(--line)}
.fl{font-size:9px;letter-spacing:1px;text-transform:uppercase;padding:3px 8px;border-radius:2px;border:1px solid var(--line);color:var(--mut)}
.fl.no{color:var(--amber);border-color:var(--amber)}
.fl.q{color:var(--mut)}
.fl.v{color:var(--pink);border-color:var(--pink)}
.story-meta b.go2{color:var(--go)}
.ur{color:var(--mut)}

/* catalogue top bar */
.cat-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.cat-count{font-size:11px;color:var(--mut);letter-spacing:2px;text-transform:uppercase}
.editv{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--mut);border:1px solid var(--line);padding:4px 9px;border-radius:2px}
.logbtn.done{color:var(--mut);border-color:var(--line)}

/* mag editor extras */
.row2{display:flex;gap:10px}
.row2 .fld{flex:1}
.btn-del-full{width:100%;margin-top:12px;background:none;border:1px solid var(--no);color:var(--no);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;padding:11px;border-radius:2px}
</style>
<body>
<header>
  <div class="hd">
    <div class="logo">SUBMIT<b>/</b>DESK</div>
    <div class="sub">Story ledger</div>
  </div>
  <div class="tabs">
    <button class="tab on" data-tab="stories">Stories</button>
    <button class="tab" data-tab="magazines">Catalogue</button>
    <button class="tab" data-tab="active">In Play</button>
  </div>
</header>

<div class="wrap" id="root">
  <div class="loading">Connecting&hellip;</div>
</div>

<button class="fab" id="fab">+</button>

<!-- story modal -->
<div class="ov" id="storyModal">
  <div class="sheet">
    <h2 id="smTitle">New story</h2>
    <div class="fld"><label>Title</label><input id="f_title" placeholder="Working title" autocomplete="off"></div>
    <div class="fld"><label>Word count</label><input id="f_wc" type="number" inputmode="numeric" placeholder="e.g. 4200" autocomplete="off"></div>
    <div class="fld"><label>Notes / logline</label><textarea id="f_notes" placeholder="One line on what it is, so you remember"></textarea></div>
    <input type="hidden" id="f_id">
    <div class="sheet-btns">
      <button class="btn ghost" data-act="closeStory">Cancel</button>
      <button class="btn" data-act="saveStory">Save story</button>
    </div>
  </div>
</div>

<!-- log submission modal -->
<div class="ov" id="logModal">
  <div class="sheet">
    <h2 id="lmTitle">Log submission</h2>
    <div class="fld"><label>Date submitted</label><input id="l_date" type="date"></div>
    <div class="fld"><label>Status</label>
      <select id="l_status">
        <option value="pending">Pending</option>
        <option value="accepted">Accepted</option>
        <option value="rejected">Rejected</option>
        <option value="withdrawn">Withdrawn</option>
      </select>
    </div>
    <div class="fld"><label>Note (optional)</label><input id="l_note" placeholder="Fee paid, simultaneous, etc."></div>
    <input type="hidden" id="l_story"><input type="hidden" id="l_mag">
    <div class="sheet-btns">
      <button class="btn ghost" data-act="closeLog">Cancel</button>
      <button class="btn" data-act="saveLog">Log it</button>
    </div>
  </div>
</div>

<!-- magazine editor modal -->
<div class="ov" id="magModal">
  <div class="sheet">
    <h2 id="mmTitle">New venue</h2>
    <div class="fld"><label>Name</label><input id="m_name" placeholder="e.g. Nightjar Press" autocomplete="off"></div>
    <div class="row2">
      <div class="fld"><label>Country</label>
        <select id="m_country">
          <option value="UK">UK</option><option value="IE">Ireland</option>
          <option value="US">US</option><option value="AU">Australia</option>
          <option value="OTHER">Other</option>
        </select>
      </div>
      <div class="fld"><label>Type</label>
        <select id="m_type">
          <option value="magazine">Magazine</option>
          <option value="press">Press</option>
          <option value="chapbook">Chapbook</option>
          <option value="competition">Competition</option>
        </select>
      </div>
    </div>
    <div class="row2">
      <div class="fld"><label>Word cap (blank = no limit)</label><input id="m_cap" type="number" inputmode="numeric" placeholder="e.g. 6000" autocomplete="off"></div>
      <div class="fld"><label>Cap is a guideline?</label>
        <select id="m_soft"><option value="">Hard cap</option><option value="1">Soft / guideline</option></select>
      </div>
    </div>
    <div class="fld"><label>Reading window</label>
      <select id="m_win">
        <option value="rolling">Rolling / year-round</option>
        <option value="range">Month range (set below)</option>
        <option value="closed">Currently closed</option>
        <option value="">Unknown</option>
      </select>
    </div>
    <div class="row2" id="m_winrange" style="display:none">
      <div class="fld"><label>Opens (month)</label>
        <select id="m_winopen"><option value="1">Jan</option><option value="2">Feb</option><option value="3">Mar</option><option value="4">Apr</option><option value="5">May</option><option value="6">Jun</option><option value="7">Jul</option><option value="8">Aug</option><option value="9">Sep</option><option value="10">Oct</option><option value="11">Nov</option><option value="12">Dec</option></select>
      </div>
      <div class="fld"><label>Closes (month)</label>
        <select id="m_winclose"><option value="1">Jan</option><option value="2">Feb</option><option value="3">Mar</option><option value="4">Apr</option><option value="5">May</option><option value="6">Jun</option><option value="7">Jul</option><option value="8">Aug</option><option value="9">Sep</option><option value="10">Oct</option><option value="11">Nov</option><option value="12">Dec</option></select>
      </div>
    </div>
    <div class="fld"><label>Editor / contact</label><input id="m_editor" placeholder="Name or 'Editorial team'" autocomplete="off"></div>
    <div class="fld"><label>Submission channel</label><input id="m_channel" placeholder="e.g. Submittable (free), email, portal" autocomplete="off"></div>
    <div class="fld"><label>Website / email</label><input id="m_url" placeholder="e.g. nightjarpress.weebly.com" autocomplete="off"></div>
    <div class="fld"><label>Takes unsolicited fiction?</label>
      <select id="m_unsol"><option value="1">Yes \u2014 open subs</option><option value="0">No / invite-only</option><option value="">Unsure</option></select>
    </div>
    <div class="fld"><label>Tags (comma-separated)</label><input id="m_tags" placeholder="e.g. uncanny, dark, chapbook" autocomplete="off"></div>
    <div class="fld"><label>Notes</label><textarea id="m_note" placeholder="Anything worth remembering \u2014 register, fees, quirks"></textarea></div>
    <input type="hidden" id="m_id"><input type="hidden" id="m_seedref">
    <div class="sheet-btns">
      <button class="btn ghost" data-act="closeMag">Cancel</button>
      <button class="btn" data-act="saveMag">Save venue</button>
    </div>
    <button class="btn-del-full" id="magDelBtn" data-act="delMag" style="display:none">Delete this venue</button>
  </div>
</div>

<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
