  else if(act==='saveStory'){ saveStory(); }
  else if(act==='closeStory'){ el('storyModal').classList.remove('on'); }
  else if(act==='saveLog'){ saveLog(); }
  else if(act==='closeLog'){ el('logModal').classList.remove('on'); }
  else if(act==='newMag'){ newMag(); }
